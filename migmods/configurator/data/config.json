  "steps": [
    {
      "id": "case",
      "label": "Boîtier",
      "required": true,
      "layer": 2,
      "slot": "case",
      "priceMode": "absolute",
      "help": "Le prix final est calculé à la fin de la configuration."
    },
    {
      "id": "dial",
      "label": "Cadran",
      "required": true,
      "layer": 6,
      "slot": "dial",
      "clip": "circle",
      "help": "Certains cadrans imposent un mouvement (jour-date, GMT, squelette) : il est choisi automatiquement."
    },
    {
      "id": "crown",
      "label": "Couronne",
      "required": false,
      "layer": 11,
      "slot": "crown",
      "help": "Optionnel : par défaut, couronne assortie au boîtier."
    },
    {
      "id": "custom_logo",
      "label": "Logo personnalisé",
      "required": false,
      "layer": 6.5,
      "type": "logo",
      "help": "Un logo (PNG fond transparent, moins de 2 Mo) ou un texte, à placer sur le cadran."
    },
    {
      "id": "bezel_insert",
      "label": "Insert de lunette",
      "required": false,
      "recommended": true,
      "layer": 4,
      "slot": "insert",
      "visibleIf": "case.lunette=oui",
      "help": "Céramique ou aluminium selon modèle.",
      "priorityGroups": [
        {
          "if": "gmt_hand",
          "groups": [
            "GMT",
            "Dual Time"
          ],
          "badge": "Conseillé avec l'aiguille GMT"
        }
      ]
    },
    {
      "id": "bezel",
      "label": "Lunette",
      "required": false,
      "layer": 3,
      "slot": "bezel",
      "visibleIf": "case.lunette=oui",
      "help": "Optionnel : par défaut, lunette assortie au boîtier."
    },
    {
      "id": "chapter_ring",
      "label": "Rehaut",
      "required": false,
      "layer": 5,
      "slot": "chapter",
      "visibleIf": "case.lunette=oui",
      "help": "L'anneau entre le cadran et le verre."
    },
    {
      "id": "hands",
      "label": "Aiguilles",
      "required": true,
      "layer": 9,
      "slot": "hands",
      "help": "Aiguilles heures et minutes, toutes lumineuses."
    },
    {
      "id": "second_hand",
      "label": "Trotteuse",
      "required": true,
      "layer": 10,
      "slot": "seconds"
    },
    {
      "id": "gmt_hand",
      "label": "Aiguille GMT",
      "required": false,
      "layer": 8,
      "slot": "gmt",
      "help": "Un deuxième fuseau horaire lisible sur 24 h. Passe la montre en mouvement NH34 GMT."
    },
    {
      "id": "date_magnifier",
      "label": "Loupe de date",
      "required": false,
      "recommended": true,
      "layer": 7,
      "slot": "magnifier",
      "visibleIf": "dial.date=oui",
      "help": "Grossit la date ×2,5, la signature des montres classiques."
    },
    {
      "id": "strap",
      "label": "Bracelet",
      "required": true,
      "layer": 1,
      "slot": "strap",
      "visibleIf": "case.strap!=integre",
      "help": "Les bracelets proposés sont ceux qui s'adaptent au boîtier choisi."
    },
    {
      "id": "caseback",
      "label": "Fond de boîte",
      "required": true,
      "layer": 0,
      "slot": "none"
    },
    {
      "id": "engraving",
      "label": "Gravures",
      "required": false,
      "multiple": true,
      "layer": 0,
      "slot": "none",
      "help": "Idéal pour un cadeau. Vous nous envoyez le texte ou le fichier après la commande."
    }
  ]
