{{ 'section-cta-configurator.css' | asset_url | stylesheet_tag }}
<section class="cta-config">
  <div class="page-width cta-config__inner">
    <p class="eyebrow eyebrow--light" data-reveal>{{ section.settings.eyebrow }}</p>
    <h2 class="cta-config__title" data-reveal>{{ section.settings.heading }}</h2>
    <p class="cta-config__text" data-reveal>{{ section.settings.text }}</p>
    <a class="btn btn--light" href="{{ section.settings.link | default: '/pages/configurateur' }}" data-magnetic data-reveal><span class="btn__label">{{ section.settings.button }}</span><span class="btn__arrow" aria-hidden="true">→</span></a>
  </div>
</section>

{% schema %}
{
  "name": "Appel configurateur",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Configurateur" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Plus de 80 cadrans. Une seule montre : la vôtre." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Choisissez boîtier, cadran, lunette, aiguilles et bracelet. Le prix et le mouvement s'adaptent à chaque choix." },
    { "type": "text", "id": "button", "label": "Bouton", "default": "Composer ma montre" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "Appel configurateur" }]
}
{% endschema %}
