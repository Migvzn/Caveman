{{ 'section-cta-configurator.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Appel au configurateur, roue de cadrans (DESIGN-SYSTEM.md §9.1.5, §11.5).
  Roue décorative (aria-hidden, aucun lien) : vignettes posées sur un cercle, création en écrin au centre ;
  elle tourne de 0 à 60° avec le défilement (animation-timeline, sinon statique), les cadrans restant droits.
  Ordinateur : texte en colonnes 1 à 5 (axe A), roue en 6 à 12. Téléphone : roue au-dessus du texte, bouton pleine largeur.
{%- endcomment -%}
{%- liquid
  assign cc = section.settings
  assign cc_title_id = 'titre-configurateur-' | append: section.id
  assign cc_link = cc.link | default: '/pages/configurateur'
  assign cc_center = cc.center | default: 'abysse' | strip
  assign cc_lines = cc.dials | newline_to_br | replace: ',', '<br />' | split: '<br />'
  assign cc_ids = ''
  for cc_l in cc_lines
    assign cc_id = cc_l | strip_newlines | strip
    if cc_id != blank
      assign cc_ids = cc_ids | append: cc_id | append: ','
    endif
  endfor
  assign cc_ids = cc_ids | split: ','
  assign cc_n = cc_ids.size
-%}
{%- capture cc_title -%}
  {%- if cc.heading_line_1 != blank -%}<span class="cta-configurator__line">{{ cc.heading_line_1 }}</span> {% endif -%}
  {%- if cc.heading_line_2 != blank -%}<span class="cta-configurator__line">{{ cc.heading_line_2 }}</span>{%- endif -%}
{%- endcapture -%}
<section class="section cta-configurator" aria-labelledby="{{ cc_title_id }}">
  <div class="page-width cta-configurator__inner">
    {%- if cc_n > 0 -%}
      <div class="cta-configurator__visual">
        <div class="dial-wheel" aria-hidden="true" style="--n: {{ cc_n }}">
          <div class="dial-wheel__ring">
            {%- for cc_id in cc_ids -%}
              {%- assign cc_file = 'mm-thumbs-dial-' | append: cc_id | append: '.png' -%}
              <span class="dial-wheel__thumb" style="--k: {{ forloop.index0 }}">
                <img class="dial-wheel__img" src="{{ cc_file | asset_img_url: '144x' }}" srcset="{{ cc_file | asset_img_url: '80x' }} 80w, {{ cc_file | asset_img_url: '144x' }} 144w" sizes="(min-width: 900px) 72px, 40px" width="72" height="72" alt="" loading="lazy" decoding="async">
              </span>
            {%- endfor -%}
          </div>
          <figure class="dial-wheel__center ecrin ecrin--card">
            <img class="ecrin__img" src="{{ 'sig-' | append: cc_center | append: '-480.webp' | asset_url }}" width="480" height="480" alt="" loading="lazy" decoding="async">
          </figure>
        </div>
      </div>
    {%- endif -%}
    <div class="cta-configurator__text">
      {%- render 'section-head', eyebrow: cc.eyebrow, title: cc_title, lead: cc.text, id: cc_title_id -%}
      {%- if cc.show_facts -%}
        <ul class="cta-configurator__facts" data-reveal style="--i: 4">
          <li><span class="cta-configurator__num">{% render 'catalogue-facts', fact: 'dials' %}</span> cadrans</li>
          <li><span class="cta-configurator__num">{% render 'catalogue-facts', fact: 'cases' %}</span> boîtiers</li>
          <li><span class="cta-configurator__num">{% render 'catalogue-facts', fact: 'straps' %}</span> bracelets</li>
          <li><span class="cta-configurator__num">{% render 'catalogue-facts', fact: 'movements' %}</span> calibres Seiko</li>
        </ul>
      {%- endif -%}
      {%- if cc.button != blank -%}
        <div class="cta-configurator__actions" data-reveal style="--i: 5">
          <a class="btn btn--chrome cta-configurator__btn" href="{{ cc_link }}" data-cta-origin="cta" data-light>
            <span class="btn__label">{% render 'typo-fr', text: cc.button %}</span>
            {%- render 'icon', name: 'arrow-right', class: 'btn__icon', size: 14 -%}
          </a>
          <p class="cta-configurator__from">dès {% render 'catalogue-facts', fact: 'from_price' %}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Appel configurateur",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Le configurateur" },
    { "type": "text", "id": "heading_line_1", "label": "Titre, première ligne", "default": "Plus de 80 cadrans." },
    { "type": "inline_richtext", "id": "heading_line_2", "label": "Titre, seconde ligne", "info": "Un seul mot ou groupe en italique (chromé).", "default": "Une seule montre : <em>la vôtre.</em>" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Boîtier, cadran, lunette, aiguilles, bracelet : vous composez, j’assemble. Le prix s’affiche à chaque pièce, sans surprise. Comptez 2 à 3 semaines." },
    { "type": "checkbox", "id": "show_facts", "label": "Afficher les chiffres du catalogue (calculés)", "default": true },
    { "type": "text", "id": "button", "label": "Bouton", "default": "Créer ma montre" },
    { "type": "url", "id": "link", "label": "Lien du bouton", "info": "Par défaut : /pages/configurateur" },
    { "type": "textarea", "id": "dials", "label": "Cadrans de la roue", "info": "Identifiants des cadrans du configurateur, un par ligne (24 conseillés).", "default": "sub-bleu-soleille\nbaton-meteorite\nbaton-bleu-turquoise\nsquelette-noir\nmarine-rouge\ntapisserie-argent\nsub-vert-soleille\noh-raye-marron\nraye-rose\nsub-noir\ntapisserie-jaune\nsquelette-bleu-oak\nbaton-blanc\nraye-vert-eau\nbaton-violet\nmarine-dore\ntapisserie-bleu\nbaton-gris-soleille\noh-raye-vert\ntapisserie-rouge\nsquelette-argent\narabe-bleu-glacier\nsub-carbone-forge\nmarine-vert" },
    { "type": "text", "id": "center", "label": "Création au centre de la roue", "info": "Identifiant d’une création signature (abysse, meteorite, lagon, nocturne, quantieme, instrument).", "default": "abysse" }
  ],
  "presets": [{ "name": "Appel configurateur" }]
}
{% endschema %}
