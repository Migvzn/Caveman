<article class="section">
  <div class="page-width page-width--narrow">
    <p class="eyebrow">{{ article.published_at | date: format: 'date' }}</p>
    <h1 class="page-title">{{ article.title }}</h1>
    {%- if article.image -%}<div class="article__media">{{ article.image | image_url: width: 1600 | image_tag: widths: '700, 1000, 1400, 1600', sizes: '(min-width: 990px) 760px, 100vw', loading: 'eager', alt: article.image.alt | default: article.title }}</div>{%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p><a class="link-arrow" href="{{ blog.url }}">Retour au journal</a></p>
  </div>
</article>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
