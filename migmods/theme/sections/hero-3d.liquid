<section class="hero3d" data-watch-host data-hero3d>
  <div class="hero3d__glow" aria-hidden="true"></div>
  <div class="page-width hero3d__inner">
    <div class="hero3d__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--light" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero3d__title" data-split>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero3d__text" data-reveal style="--d: .35s">{{ section.settings.text }}</p>{%- endif -%}
      <div class="btn-row" data-reveal style="--d: .5s">
        {%- if section.settings.button_1 != blank -%}
          <a href="{{ section.settings.link_1 | default: '/pages/configurateur' }}" class="btn btn--light" data-magnetic><span class="btn__label">{{ section.settings.button_1 }}</span><span class="btn__arrow" aria-hidden="true">→</span></a>
        {%- endif -%}
        {%- if section.settings.button_2 != blank -%}
          <a href="{{ section.settings.link_2 | default: '/collections/montres-pretes' }}" class="btn btn--ghost-light" data-magnetic><span class="btn__label">{{ section.settings.button_2 }}</span></a>
        {%- endif -%}
      </div>
      <dl class="hero3d__specs" data-reveal style="--d: .65s">
        <div><dt>Heure de l'atelier</dt><dd data-clock>--:--</dd></div>
        <div><dt>Mouvement</dt><dd>Seiko NH35</dd></div>
        <div><dt>Fréquence</dt><dd>21 600 alt/h</dd></div>
      </dl>
    </div>

    <div class="hero3d__stage">
      <canvas class="hero3d__canvas" data-watch-canvas aria-label="Montre MigMods en 3D. Les aiguilles indiquent l'heure réelle." role="img"></canvas>
      {%- if section.settings.fallback != blank -%}
        {{ section.settings.fallback | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'hero3d__fallback', alt: section.settings.heading, loading: 'eager' }}
      {%- endif -%}
      <button type="button" class="lume-toggle" data-lume aria-pressed="false">
        <span class="lume-toggle__dot" aria-hidden="true"></span>
        <span>Voir la lume BGW9</span>
      </button>
    </div>
  </div>
  <a class="hero3d__scroll" href="#anatomie" aria-label="Découvrir l'anatomie de la montre"><span></span></a>
</section>

<script type="module">
  import { mountWatch } from "{{ 'migmods-3d.js' | asset_url }}";
  const host = document.querySelector('[data-hero3d]');
  const canvas = host.querySelector('[data-watch-canvas]');
  try {
    const watch = await mountWatch(canvas, { mode: 'hero', dial: {{ section.settings.dial_color | json }}, insert: {{ section.settings.insert_color | json }}, metal: {{ section.settings.metal | json }} });
    host.classList.add('is-3d');
    const btn = host.querySelector('[data-lume]');
    btn.addEventListener('click', () => {
      const on = !watch.lume;
      watch.setLume(on);
      btn.setAttribute('aria-pressed', on);
      host.classList.toggle('is-lume', on);
    });
  } catch (e) {
    host.classList.add('no-3d');
  }
</script>

{% schema %}
{
  "name": "Hero 3D",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Atelier MigMods · Évreux, Normandie" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Votre Seiko mod, assemblée à la main" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Boîtier 316L, verre saphir, mouvement automatique Seiko. Vous la composez, nous l'assemblons, la testons et la réglons à l'atelier." },
    { "type": "text", "id": "button_1", "label": "Bouton 1", "default": "Créer ma montre" },
    { "type": "url", "id": "link_1", "label": "Lien 1" },
    { "type": "text", "id": "button_2", "label": "Bouton 2", "default": "Montres prêtes à porter" },
    { "type": "url", "id": "link_2", "label": "Lien 2" },
    { "type": "header", "content": "Montre 3D" },
    { "type": "color", "id": "dial_color", "label": "Couleur du cadran", "default": "#1d3b7a" },
    { "type": "color", "id": "insert_color", "label": "Couleur de l'insert", "default": "#141414" },
    { "type": "select", "id": "metal", "label": "Métal", "default": "steel", "options": [{ "value": "steel", "label": "Acier" }, { "value": "gold", "label": "Doré" }] },
    { "type": "image_picker", "id": "fallback", "label": "Image de secours (navigateurs sans 3D)" }
  ],
  "presets": [{ "name": "Hero 3D" }]
}
{% endschema %}
