{{ 'section-marquee.css' | asset_url | stylesheet_tag }}
<div class="marquee{% if section.settings.dark %} marquee--dark{% endif %}" aria-label="{{ section.settings.items | escape }}">
  {%- assign items = section.settings.items | split: '|' -%}
  <div class="marquee__track" aria-hidden="true">
    {%- for n in (1..2) -%}
      <div class="marquee__group">
        {%- for it in items -%}<span class="marquee__item">{{ it | strip }}</span><span class="marquee__sep">✦</span>{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bandeau défilant",
  "settings": [
    { "type": "text", "id": "items", "label": "Éléments (séparés par |)", "default": "Verre saphir|Mouvement Seiko NH35|Acier 316L|Lume BGW9|Testée à 200 m|Réglée au chronocomparateur|Assemblée à Évreux" },
    { "type": "checkbox", "id": "dark", "label": "Fond sombre", "default": false }
  ],
  "presets": [{ "name": "Bandeau défilant" }]
}
{% endschema %}
