<section class="section">
  <div class="page-width page-width--narrow">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'contact', id: 'contact-form', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status">Merci, votre message est bien parti. Réponse sous 24 à 48 h.</p>
      {%- elsif form.errors -%}
        <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form__row">
        <div class="field"><label for="contact-name">Nom</label><input class="input" id="contact-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div class="field"><label for="contact-email">E-mail <span aria-hidden="true">*</span></label><input class="input" id="contact-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      </div>
      <div class="field"><label for="contact-phone">Téléphone</label><input class="input" id="contact-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
      <div class="field"><label for="contact-subject">Sujet</label>
        <select class="input" id="contact-subject" name="contact[Sujet]">
          <option>Question sur une montre</option><option>Montre sur-mesure</option><option>Remise en main propre</option><option>Service après-vente</option><option>Autre</option>
        </select>
      </div>
      <div class="field"><label for="contact-body">Message <span aria-hidden="true">*</span></label><textarea class="input" id="contact-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
      <button type="submit" class="btn btn--primary">Envoyer</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nous écrire" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une question sur un modèle, une idée de montre sur-mesure ? Écrivez-nous.</p>" }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
