{%- liquid
  assign src = section.settings.video_url
  if src == blank
    assign src = 'https://cdn.shopify.com/videos/c/o/v/5b5e75b4c32240d7b3ba1701099150d4.mp4'
  endif
  assign poster = section.settings.poster | image_url: width: 1600
  if section.settings.poster == blank
    assign poster = 'migmods-hero-poster.jpg' | asset_url
  endif
-%}
<section class="hero-video" data-hero-video>
  <div class="hero-video__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'auto', class: 'hero-video__el', image_size: '1600x' }}
    {%- else -%}
      <video class="hero-video__el" autoplay muted loop playsinline preload="auto" poster="{{ poster }}">
        <source src="{{ src }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>
  <div class="hero-video__shade" aria-hidden="true"></div>

  <div class="page-width hero-video__content">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="hero-video__title" data-reveal style="--d: .15s">{{ section.settings.heading }}</h1>{%- endif -%}
    <div class="btn-row" data-reveal style="--d: .3s">
      {%- if section.settings.button_1 != blank -%}
        <a href="{{ section.settings.link_1 | default: '/pages/configurateur' }}" class="btn btn--chrome" data-magnetic><span class="btn__label">{{ section.settings.button_1 }}</span><span class="btn__arrow" aria-hidden="true">→</span></a>
      {%- endif -%}
      {%- if section.settings.button_2 != blank -%}
        <a href="{{ section.settings.link_2 | default: '/collections/montres-pretes' }}" class="btn btn--chrome-ghost" data-magnetic><span class="btn__label">{{ section.settings.button_2 }}</span></a>
      {%- endif -%}
    </div>
  </div>

  <button type="button" class="sound-toggle" data-sound aria-pressed="false">
    <span class="sound-toggle__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span data-sound-label>Activer le son</span>
  </button>
  <a class="hero-video__scroll" href="#main-after-hero" aria-label="Faire défiler"><span></span></a>
</section>
<span id="main-after-hero"></span>

{% schema %}
{
  "name": "Vidéo plein écran",
  "settings": [
    { "type": "video", "id": "video", "label": "Vidéo (Contenu > Fichiers)", "info": "Boucle, démarre sans le son. Le visiteur peut activer le son." },
    { "type": "text", "id": "video_url", "label": "Ou lien direct vers un MP4" },
    { "type": "image_picker", "id": "poster", "label": "Image affichée pendant le chargement" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Seiko mods · assemblées à la main à Évreux" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "La montre que personne d'autre ne porte" },
    { "type": "text", "id": "button_1", "label": "Bouton 1", "default": "Créer ma montre" },
    { "type": "url", "id": "link_1", "label": "Lien 1" },
    { "type": "text", "id": "button_2", "label": "Bouton 2", "default": "Montres prêtes" },
    { "type": "url", "id": "link_2", "label": "Lien 2" }
  ],
  "presets": [{ "name": "Vidéo plein écran" }]
}
{% endschema %}
