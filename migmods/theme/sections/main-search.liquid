<section class="section">
  <div class="page-width">
    <h1 class="page-title">Recherche</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="search-q">Rechercher</label>
      <input id="search-q" class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Sub, cadran bleu, Naut…">
      <input type="hidden" name="type" value="product">
      <button class="btn btn--primary" type="submit">Rechercher</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="muted">{{ search.results_count }} résultat{% if search.results_count > 1 %}s{% endif %} pour « {{ search.terms | escape }} »</p>
        <div class="product-grid product-grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="card"><a class="card__title" href="{{ item.url }}">{{ item.title }}</a></article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination: next: 'Suivant', previous: 'Précédent' }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Recherche", "settings": [] }
{% endschema %}
