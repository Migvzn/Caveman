{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{{ 'component-page-header.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Le journal de l'atelier (DESIGN-SYSTEM.md §9.12) : premier article en grand (page 1), puis grille 1 / 2 / 3,
  pagination en liens de 44 px. Temps de lecture = mots / 200, arrondi au-dessus. Vide : « Le journal de l'atelier ouvre bientôt. »
{%- endcomment -%}
{%- liquid
  assign jb = section.settings
  assign jb_id = 'blog-title-' | append: section.id
  assign jb_title = blog.title | default: 'Le journal de l’atelier'
-%}
<section class="main-blog" aria-labelledby="{{ jb_id }}">
  <div class="page-width">
    {%- render 'page-header', eyebrow: jb.eyebrow, title: jb_title, lead: jb.lead, id: jb_id -%}

    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size == 0 -%}
        <div class="main-blog__empty">
          <p class="main-blog__empty-text">{% render 'typo-fr', text: jb.empty_text %}</p>
          <a class="link-arrow" href="/pages/configurateur" data-cta-origin="journal">Créer ma montre{% render 'icon', name: 'arrow-right', size: 14 %}</a>
        </div>
      {%- else -%}
        <ul class="main-blog__list" role="list">
          {%- for article in blog.articles -%}
            {%- liquid
              assign feature = false
              if forloop.first and paginate.current_page == 1
                assign feature = true
              endif
              assign words = article.content | strip_html | split: ' ' | size
              assign minutes = words | plus: 199 | divided_by: 200
              if minutes < 1
                assign minutes = 1
              endif
              assign a_alt = article.image.alt | default: article.title
            -%}
            <li class="main-blog__item{% if feature %} main-blog__item--feature{% endif %}"{% unless feature %} data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}"{% endunless %}>
              <article class="main-blog__card">
                {%- if article.image -%}
                  <a class="main-blog__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                    {%- if feature -%}
                      {{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 1440px) 1360px, 100vw', loading: 'eager', fetchpriority: 'high', alt: a_alt, class: 'main-blog__img' }}
                    {%- else -%}
                      {{ article.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw', loading: 'lazy', alt: a_alt, class: 'main-blog__img' }}
                    {%- endif -%}
                  </a>
                {%- endif -%}
                <div class="main-blog__body">
                  <p class="main-blog__meta">{{ article.published_at | time_tag: format: 'date' }} · {{ minutes }} min de lecture</p>
                  <h2 class="main-blog__title"><a class="main-blog__link" href="{{ article.url }}">{{ article.title }}</a></h2>
                  {%- if article.excerpt_or_content != blank -%}
                    <p class="main-blog__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 32 }}</p>
                  {%- endif -%}
                  {%- if feature -%}
                    <span class="link-arrow main-blog__more" aria-hidden="true">Lire l’article{% render 'icon', name: 'arrow-right', size: 14 %}</span>
                  {%- endif -%}
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="main-blog__pagination" aria-label="Pages du journal">
            {%- if paginate.previous -%}
              <a class="main-blog__page main-blog__page--step" href="{{ paginate.previous.url }}">{% render 'icon', name: 'arrow-left', size: 14 %}<span>Précédent</span></a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a class="main-blog__page" href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="main-blog__page" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="main-blog__page main-blog__page--gap" aria-hidden="true">…</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a class="main-blog__page main-blog__page--step" href="{{ paginate.next.url }}"><span>Suivant</span>{% render 'icon', name: 'arrow-right', size: 14 %}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "MigMods · Journal" },
    { "type": "text", "id": "lead", "label": "Chapô", "default": "Les montres en cours d’assemblage, les pièces qui arrivent, les gestes de l’établi." },
    { "type": "text", "id": "empty_text", "label": "Journal vide", "default": "Le journal de l’atelier ouvre bientôt." }
  ]
}
{% endschema %}
