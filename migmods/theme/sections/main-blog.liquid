{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
<section class="section">
  <div class="page-width">
    <h1 class="page-title">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <a class="article-card" href="{{ article.url }}">
            {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: widths: '450, 700, 900', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title }}{%- endif -%}
            <p class="muted">{{ article.published_at | date: format: 'date' }}</p>
            <h2 class="article-card__title">{{ article.title }}</h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination: next: 'Suivant', previous: 'Précédent' }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
