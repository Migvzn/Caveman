<section class="section usp">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
    <ul class="usp__grid">
      {%- for block in section.blocks -%}
        <li class="usp__item" {{ block.shopify_attributes }}>
          {% render 'icon', icon: block.settings.icon %}
          <h3 class="usp__title">{{ block.settings.title }}</h3>
          <p class="usp__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Arguments",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" }
  ],
  "blocks": [
    {
      "type": "item", "name": "Argument",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "crystal", "options": [
          { "value": "crystal", "label": "Verre saphir" }, { "value": "movement", "label": "Mouvement" }, { "value": "water", "label": "Étanchéité" },
          { "value": "hand", "label": "Réglage" }, { "value": "pin", "label": "Livraison locale" }, { "value": "shield", "label": "Garantie" } ] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Verre saphir" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Quasi inrayable, transparence parfaite." }
      ]
    }
  ],
  "presets": [{
    "name": "Arguments",
    "blocks": [
      { "type": "item", "settings": { "icon": "crystal", "title": "Verre saphir", "text": "Quasi inrayable, il garde une transparence parfaite au fil des années." } },
      { "type": "item", "settings": { "icon": "movement", "title": "Mouvement automatique Seiko", "text": "Il se remonte au poignet, environ 41 h de réserve de marche, robuste et simple à entretenir." } },
      { "type": "item", "settings": { "icon": "water", "title": "Testée et réglée", "text": "Chaque montre est testée en étanchéité et réglée au chronocomparateur avant de partir." } }
    ]
  }]
}
{% endschema %}
