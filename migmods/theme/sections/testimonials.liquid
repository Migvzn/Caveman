<section class="section testimonials">
  <div class="page-width">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <ul class="testimonials__grid">
      {%- for block in section.blocks -%}
        <li class="quote" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <p class="quote__stars" aria-label="Note : {{ block.settings.rating }} sur 5">{% for i in (1..block.settings.rating) %}★{% endfor %}</p>
          {%- endif -%}
          <blockquote class="quote__text">{{ block.settings.quote }}</blockquote>
          <p class="quote__author">{{ block.settings.author }}{% if block.settings.detail != blank %} · <span class="muted">{{ block.settings.detail }}</span>{% endif %}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils portent une MigMods" }
  ],
  "blocks": [
    { "type": "quote", "name": "Avis", "settings": [
      { "type": "textarea", "id": "quote", "label": "Avis (vrai avis client uniquement)", "default": "[À COMPLÉTER : avis client réel]" },
      { "type": "text", "id": "author", "label": "Prénom", "default": "[Prénom]" },
      { "type": "text", "id": "detail", "label": "Détail", "default": "[Modèle, ville]" },
      { "type": "range", "id": "rating", "label": "Note", "min": 0, "max": 5, "step": 1, "default": 5 }
    ] }
  ],
  "presets": [{ "name": "Avis clients", "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }] }]
}
{% endschema %}
