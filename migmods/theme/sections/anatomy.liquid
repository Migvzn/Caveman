<section class="anatomy" id="anatomie" data-anatomy data-watch-host style="--steps: {{ section.blocks.size }}">
  <div class="anatomy__sticky">
    <div class="page-width anatomy__grid">
      <div class="anatomy__head">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        <div class="anatomy__bar" aria-hidden="true"><span data-anatomy-bar></span></div>
      </div>
      <canvas class="anatomy__canvas" data-watch-canvas role="img" aria-label="Vue éclatée de la montre : verre, lunette, aiguilles, cadran, mouvement, boîtier."></canvas>
      <ol class="anatomy__list">
        {%- for block in section.blocks -%}
          <li class="anatomy__item" data-anatomy-item {{ block.shopify_attributes }}>
            <span class="anatomy__spec">{{ block.settings.spec }}</span>
            <h3 class="anatomy__title">{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

<script type="module">
  import { mountWatch } from "{{ 'migmods-3d.js' | asset_url }}";
  const sec = document.querySelector('[data-anatomy]');
  const items = [...sec.querySelectorAll('[data-anatomy-item]')];
  const bar = sec.querySelector('[data-anatomy-bar]');
  let watch = null;
  try { watch = await mountWatch(sec.querySelector('[data-watch-canvas]'), { mode: 'anatomy', dial: {{ section.settings.dial_color | json }} }); sec.classList.add('is-3d'); }
  catch (e) { sec.classList.add('no-3d'); }
  const onScroll = () => {
    const r = sec.getBoundingClientRect(), total = sec.offsetHeight - innerHeight;
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
    watch && watch.setExplode(Math.min(1, p * 1.8));
    bar.style.transform = 'scaleX(' + p + ')';
    const active = Math.min(items.length - 1, Math.floor(p * items.length * 0.999));
    items.forEach((it, i) => it.classList.toggle('is-active', i === active));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

{% schema %}
{
  "name": "Anatomie 3D",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Anatomie d'une MigMods" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Six couches, assemblées à la main" },
    { "type": "color", "id": "dial_color", "label": "Couleur du cadran", "default": "#1f4d3a" }
  ],
  "blocks": [
    { "type": "part", "name": "Composant", "settings": [
      { "type": "text", "id": "spec", "label": "Donnée", "default": "9 Mohs" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Verre saphir" },
      { "type": "textarea", "id": "text", "label": "Texte" }
    ] }
  ],
  "presets": [{ "name": "Anatomie 3D" }]
}
{% endschema %}
