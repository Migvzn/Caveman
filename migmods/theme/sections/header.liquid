{%- liquid
  assign overlay = false
  if template.name == 'index' and section.settings.overlay_home
    assign overlay = true
  endif
-%}
{%- if section.settings.announcement != blank -%}
  <div class="announcement">
    <div class="page-width announcement__inner">
      {%- if section.settings.announcement_link != blank -%}
        <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement }} <span aria-hidden="true">→</span></a>
      {%- else -%}
        <span>{{ section.settings.announcement }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<header class="site-header{% if overlay %} site-header--overlay{% endif %}" data-header>
  <div class="page-width site-header__inner">
    <button type="button" class="icon-btn burger" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span class="burger__lines" aria-hidden="true"><span></span><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="site-nav" aria-label="Menu principal">
      <ul class="site-nav__list">
        {%- for link in section.settings.menu.links -%}
          <li class="site-nav__item{% if link.links.size > 0 %} has-mega{% endif %}">
            <a href="{{ link.url }}" class="site-nav__link"{% if link.current or link.child_active %} aria-current="page"{% endif %}{% if link.links.size > 0 %} aria-haspopup="true" aria-expanded="false" data-mega-trigger{% endif %}>
              <span>{{ link.title }}</span>
            </a>
            {%- if link.links.size > 0 -%}
              <div class="mega" data-mega>
                <div class="page-width mega__inner">
                  <ul class="mega__links">
                    {%- for child in link.links -%}
                      <li style="--i: {{ forloop.index0 }}">
                        <a href="{{ child.url }}" class="mega__link">
                          <span class="mega__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                          <span class="mega__title">{{ child.title }}</span>
                          {%- if child.type == 'collection_link' and child.object.products_count > 0 -%}<span class="mega__count">{{ child.object.products_count }}</span>{%- endif -%}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                  <a class="mega__feature" href="{{ section.settings.cta_link | default: '/pages/configurateur' }}">
                    <span class="eyebrow">Sur-mesure</span>
                    <span class="mega__feature-title">Composez la vôtre, pièce par pièce</span>
                    <span class="mega__feature-text">Boîtier, cadran, lunette, aiguilles : l'aperçu se met à jour en direct.</span>
                    <span class="link-arrow">Ouvrir le configurateur</span>
                  </a>
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <a href="{{ routes.root_url }}" class="site-logo" aria-label="{{ shop.name }}, accueil">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: width: section.settings.logo_width, height: nil, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <span class="wordmark">{{ section.settings.wordmark | default: 'MIGMODS' }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__actions">
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--pill header-cta" href="{{ section.settings.cta_link | default: '/pages/configurateur' }}" data-magnetic>
          <span class="btn__label">{{ section.settings.cta_label }}</span>
        </a>
      {%- endif -%}
      <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Rechercher">{% render 'icon', icon: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-btn hide-mobile" aria-label="Mon compte">{% render 'icon', icon: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-btn cart-link" aria-label="Panier">
        {% render 'icon', icon: 'bag' %}
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{% render 'cart-count' %}</span>
      </a>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <div class="mobile-menu__inner">
    <button type="button" class="icon-btn mobile-menu__close" data-menu-close aria-label="Fermer le menu">
      <span class="burger__lines is-x" aria-hidden="true"><span></span><span></span></span>
    </button>
    <nav aria-label="Menu mobile">
      <ul class="mobile-menu__list">
        {%- for link in section.settings.menu.links -%}
          <li style="--i: {{ forloop.index0 }}">
            {%- if link.links.size > 0 -%}
              <details>
                <summary>{{ link.title }}</summary>
                <ul>
                  {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="mobile-menu__foot">
      <a class="btn btn--light btn--block" href="{{ section.settings.cta_link | default: '/pages/configurateur' }}"><span class="btn__label">{{ section.settings.cta_label | default: 'Créer ma montre' }}</span><span class="btn__arrow" aria-hidden="true">→</span></a>
      <p class="muted">{{ section.settings.announcement }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Bandeau d'annonce", "default": "Livraison offerte · en main propre dans l'Eure et à Rouen dès 300 €" },
    { "type": "url", "id": "announcement_link", "label": "Lien du bandeau" },
    { "type": "text", "id": "wordmark", "label": "Logo texte", "default": "MIGMODS" },
    { "type": "image_picker", "id": "logo", "label": "Logo image (remplace le logo texte)" },
    { "type": "range", "id": "logo_width", "label": "Largeur du logo image", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "overlay_home", "label": "En-tête transparent sur l'accueil", "default": true },
    { "type": "text", "id": "cta_label", "label": "Bouton d'en-tête", "default": "Créer ma montre" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" }
  ]
}
{% endschema %}
