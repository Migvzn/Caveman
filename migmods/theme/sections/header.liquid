{{ 'section-header.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  En-tête MigMods (DESIGN-SYSTEM.md §8.2 à 8.4) : un seul bloc fixe (annonce + barre), méga-menu « Collections »,
  menu mobile <dialog class="menu-sheet">. Comportements : assets/section-header.js (<mig-header>).
  - Accueil : barre transparente sur la vidéo (réglage overlay_home), voile --veil-top derrière l'annonce et les icônes.
  - Page configurateur : en-tête compact (pas d'annonce, barre de 60 px en verre dès le départ, jamais masquée).
  - Ordinateur (≥ 1280 px) : 4 liens au plus ; le lien dont l'URL vaut celle du bouton est retiré (pas de doublon).
{%- endcomment -%}
{%- liquid
  assign compact = false
  if template.name == 'page' and template.suffix == 'configurateur'
    assign compact = true
  endif
  assign overlay = false
  if template.name == 'index' and section.settings.overlay_home
    assign overlay = true
  endif
  assign cta_url = section.settings.cta_link | default: '/pages/configurateur'
  assign cta_label = section.settings.cta_label | default: 'Créer ma montre'
  assign menu = section.settings.menu
  assign threshold = settings.free_local_threshold | default: 300 | times: 100 | money_without_trailing_zeros | replace: ' €', ' €'
  # « {seuil} » passe par une variable : une accolade dans une balise de sortie y couperait la variable (Shopify)
  assign seuil_tok = '{seuil}'

  capture cart_n
    render 'cart-count'
  endcapture
  assign cart_n = cart_n | strip | plus: 0
  if cart_n > 1
    assign cart_label = 'Panier, ' | append: cart_n | append: ' articles'
  else
    assign cart_label = 'Panier, ' | append: cart_n | append: ' article'
  endif

  assign mega_link = nil
  assign nav_count = 0
  for link in menu.links
    if link.url == cta_url
      continue
    endif
    assign nav_count = nav_count | plus: 1
    if nav_count > 4
      break
    endif
    if mega_link == nil and link.links.size > 0
      assign mega_link = link
    endif
  endfor
-%}

<mig-header>
<header class="site-header{% if overlay %} site-header--overlay{% endif %}{% if compact %} site-header--compact{% endif %}" data-header>

  {%- unless compact -%}
    {%- capture ann_items -%}
      {%- assign ann_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign a_text = block.settings.text | strip
          assign a_short = block.settings.text_short | strip | default: a_text
          assign draft = false
          if a_text contains '[À COMPL' or a_text contains '[À VÉRIF' or a_short contains '[À COMPL' or a_short contains '[À VÉRIF'
            assign draft = true
          endif
        -%}
        {%- if a_text == blank -%}{%- continue -%}{%- endif -%}
        {%- if draft -%}
          {%- if request.design_mode -%}<p class="announcement__item{% if ann_i == 0 %} is-active{% endif %}" {{ block.shopify_attributes }}><span class="draft-badge">À compléter</span></p>{%- assign ann_i = ann_i | plus: 1 -%}{%- endif -%}
          {%- continue -%}
        {%- endif -%}
        {%- capture a_long -%}{%- render 'typo-fr', text: a_text -%}{%- endcapture -%}
        {%- capture a_mini -%}{%- render 'typo-fr', text: a_short -%}{%- endcapture -%}
        <p class="announcement__item{% if ann_i == 0 %} is-active{% endif %}" data-ann-item {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a class="announcement__link" href="{{ block.settings.link }}">
              <span class="announcement__text announcement__text--long">{{ a_long | replace: seuil_tok, threshold }}</span>
              <span class="announcement__text announcement__text--short">{{ a_mini | replace: seuil_tok, threshold }}</span>
              {%- render 'icon', name: 'arrow-right', size: 12, class: 'announcement__icon' -%}
            </a>
          {%- else -%}
            <span class="announcement__text announcement__text--long">{{ a_long | replace: seuil_tok, threshold }}</span>
            <span class="announcement__text announcement__text--short">{{ a_mini | replace: seuil_tok, threshold }}</span>
          {%- endif -%}
        </p>
        {%- assign ann_i = ann_i | plus: 1 -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if ann_items != blank -%}
      <div class="announcement" data-announcement>
        <div class="announcement__track page-width">{{ ann_items }}</div>
      </div>
    {%- endif -%}
  {%- endunless -%}

  <div class="site-header__bar">
    <div class="site-header__inner page-width">
      <div class="site-header__start">
        <button class="btn btn--icon site-header__burger" type="button" aria-controls="menu-sheet" aria-expanded="false" aria-label="Ouvrir le menu" data-menu-open>
          {%- render 'icon', name: 'menu' -%}
        </button>

        <nav class="site-nav" aria-label="Navigation principale">
          <ul class="site-nav__list">
            {%- assign nav_i = 0 -%}
            {%- for link in menu.links -%}
              {%- if link.url == cta_url -%}{%- continue -%}{%- endif -%}
              {%- assign nav_i = nav_i | plus: 1 -%}
              {%- if nav_i > 4 -%}{%- break -%}{%- endif -%}
              {%- liquid
                assign active = false
                if link.current or link.child_active
                  assign active = true
                endif
              -%}
              {%- if mega_link != nil and link.handle == mega_link.handle and link.url == mega_link.url -%}
                <li class="site-nav__item has-mega">
                  <button class="site-nav__link{% if active %} is-active{% endif %}" type="button" aria-expanded="false" aria-controls="mega-collections" data-mega-trigger>
                    <span class="site-nav__label">{{ link.title | replace: "'", '’' | escape }}</span>
                    {%- render 'icon', name: 'chevron-down', size: 12, class: 'site-nav__chevron' -%}
                  </button>
                </li>
              {%- else -%}
                <li class="site-nav__item">
                  <a class="site-nav__link{% if active %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% elsif link.child_active %} aria-current="true"{% endif %}>
                    <span class="site-nav__label">{{ link.title | replace: "'", '’' | escape }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <span class="site-nav__ink" aria-hidden="true"></span>
        </nav>
      </div>

      <a class="site-header__logo site-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | default: 'MigMods' | escape }}, accueil">
        {%- render 'logo', context: 'header', decorative: true -%}
      </a>

      <div class="site-header__end">
        <div class="site-header__icons">
          <a class="btn btn--icon site-header__icon" href="{{ routes.search_url }}" aria-label="Rechercher">
            {%- render 'icon', name: 'search' -%}
          </a>
          {%- if shop.customer_accounts_enabled -%}
            <a class="btn btn--icon site-header__icon site-header__account" href="{{ routes.account_url }}" aria-label="Mon compte">
              {%- render 'icon', name: 'user' -%}
            </a>
          {%- endif -%}
          <a class="btn btn--icon site-header__icon site-header__cart" href="{{ routes.cart_url }}" aria-label="{{ cart_label }}" data-cart-link>
            {%- render 'icon', name: 'bag' -%}
            <span class="cart-count" data-cart-count aria-hidden="true"{% if cart_n == 0 %} hidden{% endif %}>{{ cart_n }}</span>
          </a>
        </div>
        <a class="btn btn--chrome btn--sm site-header__cta" href="{{ cta_url }}" data-cta-origin="header" data-light>
          <span class="btn__label">{{ cta_label | escape }}</span>
        </a>
      </div>
    </div>

    {%- if mega_link != nil -%}
      <div class="mega" id="mega-collections" data-mega hidden>
        <div class="mega__inner page-width">
          <ul class="mega__list" aria-label="{{ mega_link.title | replace: "'", '’' | escape }}">
            {%- for child in mega_link.links -%}
              {%- liquid
                assign c = nil
                if child.type == 'collection_link'
                  assign c = child.object
                endif
              -%}
              <li class="mega__item" style="--i: {{ forloop.index0 }}" data-mega-item="{{ forloop.index }}">
                <a class="mega__link" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                  <span class="mega__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="mega__title">{{ child.title | replace: "'", '’' | escape }}</span>
                  {%- if c != nil -%}
                    {%- if c.products_count > 0 -%}
                      <span class="mega__count">{{ c.products_count }} {% if c.products_count > 1 %}pièces{% else %}pièce{% endif %}</span>
                    {%- else -%}
                      <span class="badge badge--muted mega__soon">Bientôt</span>
                    {%- endif -%}
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
            <li class="mega__item mega__item--all" style="--i: {{ mega_link.links.size }}">
              <a class="link-arrow mega__all" href="{{ mega_link.url }}">Toutes les collections {% render 'icon', name: 'arrow-right' %}</a>
            </li>
          </ul>

          <div class="mega__visual" aria-hidden="true">
            {%- for child in mega_link.links -%}
              {%- if child.type == 'collection_link' -%}
                <div class="mega__visual-item{% if forloop.first %} is-active{% endif %}" data-mega-visual="{{ forloop.index }}">
                  {%- render 'family-visual', collection: child.object, size: 240 -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="mega__feature">
            {%- render 'watch-dial', mode: 'live', size: 120, dial: 'sub-bleu-soleille', class: 'mega__dial' -%}
            <div class="mega__feature-body">
              {%- if section.settings.mega_eyebrow != blank -%}
                <p class="eyebrow mega__eyebrow">{{ section.settings.mega_eyebrow | escape }}</p>
              {%- endif -%}
              <p class="mega__feature-title">{{ section.settings.mega_heading | default: 'Créez <em>la vôtre</em>' | replace: '<em>', '<em class="chrome-text">' }}</p>
              <p class="mega__feature-text">Plus de 80 cadrans, {% render 'catalogue-facts', fact: 'cases' %} boîtiers. Le prix suit chaque choix.</p>
              <p class="mega__feature-price"><span class="price"><span class="price__from">dès</span> <span class="price__now">{% render 'catalogue-facts', fact: 'from_price' %}</span></span></p>
              <a class="link-arrow mega__feature-link" href="{{ cta_url }}" data-cta-origin="mega">{{ section.settings.mega_link_label | default: cta_label | escape }} {% render 'icon', name: 'arrow-right' %}</a>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  <dialog class="sheet sheet--full menu-sheet" id="menu-sheet" aria-label="Menu" data-menu-sheet>
    <div class="menu-sheet__bar">
      <button class="btn btn--icon menu-sheet__close" type="button" aria-label="Fermer le menu" data-sheet-close>
        {%- render 'icon', name: 'close' -%}
      </button>
      <a class="menu-sheet__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | default: 'MigMods' | escape }}, accueil">
        {%- render 'logo', context: 'header', decorative: true, class: 'menu-sheet__logo-img' -%}
      </a>
      <a class="btn btn--icon menu-sheet__cart" href="{{ routes.cart_url }}" aria-label="{{ cart_label }}" data-cart-link>
        {%- render 'icon', name: 'bag' -%}
        <span class="cart-count" data-cart-count aria-hidden="true"{% if cart_n == 0 %} hidden{% endif %}>{{ cart_n }}</span>
      </a>
    </div>

    <div class="menu-sheet__scroll">
      <form class="menu-sheet__search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="menu-sheet-q">Rechercher une montre</label>
        <div class="capsule menu-sheet__capsule">
          {%- render 'icon', name: 'search', size: 20, class: 'menu-sheet__search-icon' -%}
          <input class="capsule__input" id="menu-sheet-q" type="search" name="q" placeholder="Rechercher une montre" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search">
          <button class="btn btn--icon capsule__btn menu-sheet__go" type="submit" aria-label="Lancer la recherche">
            {%- render 'icon', name: 'arrow-right' -%}
          </button>
        </div>
      </form>

      <nav class="menu-sheet__nav" aria-label="Navigation principale">
        <ul class="menu-sheet__list">
          {%- assign m_i = 0 -%}
          {%- for link in menu.links -%}
            {%- if link.url == cta_url -%}{%- continue -%}{%- endif -%}
            {%- assign m_i = m_i | plus: 1 -%}
            <li class="menu-sheet__item" style="--i: {{ m_i | minus: 1 }}">
              {%- if link.links.size > 0 -%}
                <button class="menu-sheet__link menu-sheet__toggle" type="button" aria-expanded="false" aria-controls="menu-sheet-sub-{{ forloop.index }}" data-menu-toggle>
                  <span class="menu-sheet__num" aria-hidden="true">{{ m_i | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="menu-sheet__label">{{ link.title | replace: "'", '’' | escape }}</span>
                  {%- render 'icon', name: 'chevron-down', size: 20, class: 'menu-sheet__chevron' -%}
                </button>
                <div class="menu-sheet__sub" id="menu-sheet-sub-{{ forloop.index }}">
                  <ul class="menu-sheet__sublist">
                    {%- for child in link.links -%}
                      <li>
                        <a class="menu-sheet__sublink" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>
                          <span>{{ child.title | replace: "'", '’' | escape }}</span>
                          {%- if child.type == 'collection_link' -%}
                            {%- if child.object.products_count > 0 -%}
                              <span class="menu-sheet__count">{{ child.object.products_count }} {% if child.object.products_count > 1 %}pièces{% else %}pièce{% endif %}</span>
                            {%- else -%}
                              <span class="menu-sheet__count">Bientôt</span>
                            {%- endif -%}
                          {%- endif -%}
                        </a>
                      </li>
                    {%- endfor -%}
                    <li>
                      <a class="menu-sheet__sublink menu-sheet__sublink--all" href="{{ link.url }}"><span>Toutes les collections</span>{% render 'icon', name: 'arrow-right', size: 16 %}</a>
                    </li>
                  </ul>
                </div>
              {%- else -%}
                <a class="menu-sheet__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                  <span class="menu-sheet__num" aria-hidden="true">{{ m_i | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="menu-sheet__label{% if link.current %} chrome-text{% endif %}">{{ link.title | replace: "'", '’' | escape }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      {%- liquid
        assign has_secondary = false
        if shop.customer_accounts_enabled or settings.social_instagram != blank or settings.social_tiktok != blank
          assign has_secondary = true
        endif
      -%}
      {%- if has_secondary -%}
        <ul class="menu-sheet__secondary">
          {%- if shop.customer_accounts_enabled -%}
            <li><a class="menu-sheet__minor" href="{{ routes.account_url }}">{% render 'icon', name: 'user', size: 20 %}<span>Mon compte</span></a></li>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <li><a class="menu-sheet__minor" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram', size: 20 %}<span>Instagram</span><span class="visually-hidden"> (nouvel onglet)</span></a></li>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <li><a class="menu-sheet__minor" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok', size: 20 %}<span>TikTok</span><span class="visually-hidden"> (nouvel onglet)</span></a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.menu_note_1 != blank or section.settings.menu_note_2 != blank -%}
        <ul class="menu-sheet__notes">
          {%- if section.settings.menu_note_1 != blank -%}
            <li class="pill-note">{% render 'icon', name: 'hand', size: 16 %}<span>{% render 'typo-fr', text: section.settings.menu_note_1 %}</span></li>
          {%- endif -%}
          {%- if section.settings.menu_note_2 != blank -%}
            <li class="pill-note">{% render 'icon', name: 'parcel', size: 16 %}<span>{% render 'typo-fr', text: section.settings.menu_note_2 %}</span></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="menu-sheet__foot">
      <a class="btn btn--chrome btn--block" href="{{ cta_url }}" data-cta-origin="menu" data-light>
        <span class="btn__label">{{ cta_label | escape }}</span>
        {%- render 'icon', name: 'arrow-right', class: 'btn__icon' -%}
      </a>
      {%- if section.settings.menu_clock_label != blank -%}
        <p class="menu-sheet__clock">{% render 'typo-fr', text: section.settings.menu_clock_label %} · <span class="clock" data-clock>{{ 'now' | date: '%H:%M' }}</span></p>
      {%- endif -%}
    </div>
  </dialog>
</header>
</mig-header>
<script src="{{ 'section-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Ordinateur : 4 liens au plus (le lien du configurateur est retiré, le bouton le porte déjà). Menu mobile : tous les liens." },
    { "type": "checkbox", "id": "overlay_home", "label": "En-tête transparent sur l'accueil", "default": true },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Créer ma montre" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton", "info": "Vide : la page du configurateur." },
    { "type": "header", "content": "Méga-menu « Collections »" },
    { "type": "paragraph", "content": "Le premier lien du menu qui a des sous-liens ouvre le méga-menu. Le nombre de boîtiers et le prix d'entrée sont calculés." },
    { "type": "text", "id": "mega_eyebrow", "label": "Surtitre", "default": "Configurateur" },
    { "type": "inline_richtext", "id": "mega_heading", "label": "Titre", "default": "Créez <em>la vôtre</em>" },
    { "type": "text", "id": "mega_link_label", "label": "Lien", "default": "Créer ma montre" },
    { "type": "header", "content": "Menu mobile" },
    { "type": "text", "id": "menu_note_1", "label": "Pastille 1", "default": "Main propre · Eure et Rouen" },
    { "type": "text", "id": "menu_note_2", "label": "Pastille 2", "default": "Colissimo suivi offert" },
    { "type": "text", "id": "menu_clock_label", "label": "Libellé de l'horloge", "default": "Atelier d’Évreux", "info": "Suivi de l'heure de Paris. Vide : pas d'horloge." }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Annonce",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Colissimo suivi offert partout en France", "info": "Une seule ligne. « {seuil} » affiche le montant de la remise en main propre offerte (réglages du thème, Livraison)." },
        { "type": "text", "id": "text_short", "label": "Version courte (téléphone)", "info": "Sous 430 px de large. Vide : le texte complet." },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ]
}
{% endschema %}
