{%- comment -%}
  Collection mise en avant (DESIGN-SYSTEM.md §9.1.3) — accueil (« montres prêtes ») et fiche produit (« Vous aimerez aussi »).
  Produits techniques exclus (snippet is-technical) ; sur une fiche, la pièce en cours est exclue.
  Collection vide : rien hors éditeur (empty_fallback = none), ou trois créations signature (empty_fallback = signatures).
  Grille de cartes : 2 colonnes < 900 px, 3 à partir de 900, « columns » à partir de 1440 ; une rangée incomplète est retirée.
{%- endcomment -%}
{%- liquid
  assign fc = section.settings
  assign fc_coll = fc.collection
  assign fc_limit = fc.limit | default: 4
  assign fc_cols = fc.columns | default: '4' | plus: 0
  assign fc_title_id = 'titre-collection-' | append: section.id
  assign fc_current = 0
  if product != blank
    assign fc_current = product.id
  endif
-%}
{%- capture fc_cards -%}
  {%- assign fc_n = 0 -%}
  {%- assign fc_total = 0 -%}
  {%- if fc_coll != blank -%}
    {%- for p in fc_coll.products -%}
      {%- capture fc_tech -%}{%- render 'is-technical', product: p -%}{%- endcapture -%}
      {%- if fc_tech != '1' -%}{%- assign fc_total = fc_total | plus: 1 -%}{%- endif -%}
      {%- if fc_tech != '1' and p.id != fc_current -%}
        {%- if fc_n < fc_limit -%}
          {%- render 'product-card', product: p, index: fc_n, sizes: '(min-width: 1440px) 320px, (min-width: 900px) 30vw, 46vw' -%}
          {%- assign fc_n = fc_n | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- liquid
  assign fc_r2 = 0
  if fc_n > 2
    assign fc_r2 = fc_n | modulo: 2
  endif
  assign fc_r3 = 0
  if fc_n > 3
    assign fc_r3 = fc_n | modulo: 3
  endif
  assign fc_rc = 0
  if fc_n > fc_cols
    assign fc_rc = fc_n | modulo: fc_cols
  endif
  assign fc_heading = fc.heading
  assign fc_link_label = ''
  if fc.link_label != blank and fc_coll != blank
    assign fc_link_label = fc.link_label | append: ' (' | append: fc_total | append: ')'
  endif
-%}

{%- if fc_n > 0 -%}
  {{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  <section class="section featured-collection" aria-labelledby="{{ fc_title_id }}">
    <div class="page-width">
      {%- render 'section-head',
        eyebrow: fc.eyebrow,
        title: fc_heading,
        link_label: fc_link_label,
        link_url: fc_coll.url,
        align: 'split',
        id: fc_title_id
      -%}
      <div class="card-grid featured-collection__grid featured-collection__grid--{{ fc_cols }}" data-trim2="{{ fc_r2 }}" data-trim3="{{ fc_r3 }}" data-trimc="{{ fc_rc }}">
        {{- fc_cards -}}
      </div>
    </div>
  </section>

{%- elsif fc.empty_fallback == 'signatures' -%}
  {{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
  {{ 'component-sig-card.css' | asset_url | stylesheet_tag }}
  <section class="section featured-collection featured-collection--signatures" aria-labelledby="{{ fc_title_id }}">
    <div class="page-width">
      {%- render 'section-head', title: 'Créations signature', align: 'split', id: fc_title_id -%}
      <div class="rail featured-collection__rail" data-rail>
        <ul class="rail__track featured-collection__sigs" tabindex="0" aria-label="Créations signature">
          {%- render 'signature-list', layout: 'card', limit: 3, origin: 'related' -%}
        </ul>
        <div class="rail__nav featured-collection__nav" aria-hidden="true"><span class="rail__count" data-rail-count>01 / 03</span><span class="rail__dots" data-rail-dots></span></div>
      </div>
    </div>
  </section>

{%- elsif request.design_mode -%}
  <div class="page-width section">
    <span class="draft-badge">Collection mise en avant : la collection choisie est vide. La section est masquée pour les visiteurs (réglage « Si la collection est vide »).</span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection mise en avant",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Montres prêtes à porter" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "info": "Un seul mot ou groupe en italique (chromé).", "default": "Assemblées, réglées, <em>prêtes à partir</em>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de montres", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Colonnes sur grand écran (1440 px et plus)", "default": "4", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "text", "id": "link_label", "label": "Lien vers la collection", "info": "Le nombre de montres est ajouté entre parenthèses.", "default": "Toutes les montres prêtes" },
    { "type": "select", "id": "empty_fallback", "label": "Si la collection est vide", "default": "none", "options": [{ "value": "none", "label": "Ne rien afficher" }, { "value": "signatures", "label": "Afficher trois créations signature" }] }
  ],
  "presets": [{ "name": "Collection mise en avant" }]
}
{% endschema %}
