<section class="section">
  <div class="page-width">
    <div class="section-head">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.collection != blank -%}
        <a class="link-arrow" href="{{ section.settings.collection.url }}">Tout voir</a>
      {%- endif -%}
    </div>
    <div class="product-grid product-grid--{{ section.settings.columns }}">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="card">
            <div class="card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <h3 class="card__title">Montre exemple</h3>
            <div class="price"><span class="price__now">{{ 24900 | money }}</span></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Modèles phares",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Modèles phares" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Colonnes (ordinateur)", "default": "4", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }] }
  ],
  "presets": [{ "name": "Modèles phares" }]
}
{% endschema %}
