<section class="section stats">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="section-title stats__title" data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
    <ul class="stats__grid">
      {%- for block in section.blocks -%}
        <li class="stat" data-reveal style="--d: {{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>
          <span class="stat__value" data-count="{{ block.settings.value }}">{{ block.settings.value }}</span><span class="stat__unit">{{ block.settings.unit }}</span>
          <span class="stat__label">{{ block.settings.label }}</span>
          <p class="stat__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Chiffres clés",
  "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Ce que vous portez au poignet" }],
  "blocks": [{ "type": "stat", "name": "Chiffre", "settings": [
    { "type": "text", "id": "value", "label": "Valeur", "default": "200" },
    { "type": "text", "id": "unit", "label": "Unité", "default": "m" },
    { "type": "text", "id": "label", "label": "Libellé", "default": "Étanchéité" },
    { "type": "textarea", "id": "text", "label": "Texte" }
  ] }],
  "presets": [{ "name": "Chiffres clés" }]
}
{% endschema %}
