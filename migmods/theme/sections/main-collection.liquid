{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-empty-atelier.css' | asset_url | stylesheet_tag }}
{{ 'component-sig-card.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Collection (DESIGN-SYSTEM.md §9.3). En-tête, état vide « à l'établi », filtres (barre sur ordinateur, feuille sur
  téléphone), grille de cartes avec la tuile « Créer la vôtre » en 3e position, « Voir plus de montres ».
  <mig-facets> (section-main-collection.js) met à jour la grille par la Section Rendering API ; sans JS, formulaires GET.
{%- endcomment -%}
{%- liquid
  assign mc_id = section.id
  assign mc_total = collection.all_products_count | default: collection.products_count
  assign mc_count = collection.products_count
  assign mc_sort = collection.sort_by | default: collection.default_sort_by

  assign mc_active = 0
  for f in collection.filters
    if f.type == 'price_range'
      if f.min_value.value != blank or f.max_value.value != blank
        assign mc_active = mc_active | plus: 1
      endif
    else
      assign mc_active = mc_active | plus: f.active_values.size
    endif
  endfor

  assign mc_clear = collection.url
  if collection.sort_by != blank
    assign mc_clear = collection.url | append: '?sort_by=' | append: collection.sort_by
  endif

  assign mc_word = 'montres'
  if mc_count == 1
    assign mc_word = 'montre'
  endif

  if collection.handle == 'all'
    assign mc_eyebrow = 'Collection'
  elsif mc_total == 0
    assign mc_eyebrow = 'Collection · bientôt'
  elsif mc_total == 1
    assign mc_eyebrow = 'Collection · 1 pièce'
  else
    assign mc_eyebrow = 'Collection · ' | append: mc_total | append: ' pièces'
  endif
  assign mc_lead = collection.description | strip_html | strip | truncatewords: 40
  assign mc_title_id = 'mc-title-' | append: mc_id
  assign mc_form_id = 'alerte-' | append: mc_id
-%}
<section class="section main-collection" aria-labelledby="mc-title-{{ mc_id }}">
  {%- if collection.image -%}
    <div class="main-collection__bg" aria-hidden="true">
      {{ collection.image | image_url: width: 1600 | image_tag: widths: '800, 1200, 1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: '', loading: 'eager', decoding: 'async', class: 'main-collection__bg-img' }}
    </div>
  {%- endif -%}

  <div class="page-width main-collection__inner">
    <nav class="crumbs main-collection__crumbs" aria-label="Fil d’Ariane">
      <ol>
        <li><a href="{{ routes.root_url }}">Accueil</a></li>
        <li><a href="{{ routes.collections_url }}">{%- render 'icon', name: 'arrow-left', size: 14 -%}Collections</a></li>
        <li><span aria-current="page">{{ collection.title | escape }}</span></li>
      </ol>
    </nav>

    {%- render 'section-head', eyebrow: mc_eyebrow, title: collection.title, lead: mc_lead, tag: 'h1', id: mc_title_id -%}

    <mig-facets class="main-collection__body" data-section="{{ mc_id }}">
      {%- if mc_total == 0 and mc_active == 0 -%}
        {%- capture mc_empty_eyebrow -%}{{ collection.title | escape }} · à l’établi{%- endcapture -%}
        {%- render 'empty-atelier', context: 'collection', handle: collection.handle, eyebrow: mc_empty_eyebrow, eyebrow_short: 'À l’établi', form_id: mc_form_id -%}
      {%- else -%}
        {%- paginate collection.products by section.settings.per_page -%}
          {%- comment -%} ---------- Barre d'outils (ordinateur ≥ 900 px ; sans JS, à toutes les largeurs) {%- endcomment -%}
          <div class="facets" data-facets-toolbar>
            <form class="facets__bar" action="{{ collection.url }}" method="get" data-facets-form id="mc-desk-{{ mc_id }}">
              <p class="facets__count" data-facets-count>{{ mc_count }} {{ mc_word }}</p>
              <div class="facets__fields">
                {%- for filter in collection.filters -%}
                  {%- case filter.type -%}
                    {%- when 'list' or 'boolean' -%}
                      {%- assign f_sel = filter.active_values.first.value -%}
                      <div class="facets__field">
                        <label class="visually-hidden" for="mc-d-{{ mc_id }}-{{ forloop.index }}">{{ filter.label | escape }}</label>
                        <span class="select"><select class="input facets__select" id="mc-d-{{ mc_id }}-{{ forloop.index }}" name="{{ filter.param_name }}">
                          <option value="">{{ filter.label | escape }}</option>
                          {%- for v in filter.values -%}
                            <option value="{{ v.value | escape }}"{% if v.value == f_sel %} selected{% endif %}{% if v.count == 0 and v.active == false %} disabled{% endif %}>{{ v.label | escape }} ({{ v.count }})</option>
                          {%- endfor -%}
                        </select></span>
                      </div>
                    {%- when 'price_range' -%}
                      {%- liquid
                        assign p_max = filter.range_max | divided_by: 100 | ceil
                        assign p_lo = ''
                        assign p_hi = ''
                        if filter.min_value.value != blank
                          assign p_lo = filter.min_value.value | divided_by: 100
                        endif
                        if filter.max_value.value != blank
                          assign p_hi = filter.max_value.value | divided_by: 100
                        endif
                      -%}
                      <fieldset class="facets__price">
                        <legend class="visually-hidden">{{ filter.label | escape }} en euros</legend>
                        <span class="facets__price-label" aria-hidden="true">{{ filter.label | escape }}</span>
                        <label class="visually-hidden" for="mc-d-{{ mc_id }}-pmin">Prix minimum en euros</label>
                        <input class="input facets__num" id="mc-d-{{ mc_id }}-pmin" type="number" inputmode="numeric" enterkeyhint="done" min="0" max="{{ p_max }}" step="1" placeholder="0" name="{{ filter.min_value.param_name }}" value="{{ p_lo }}">
                        <span class="facets__price-sep" aria-hidden="true">–</span>
                        <label class="visually-hidden" for="mc-d-{{ mc_id }}-pmax">Prix maximum en euros</label>
                        <input class="input facets__num" id="mc-d-{{ mc_id }}-pmax" type="number" inputmode="numeric" enterkeyhint="done" min="0" max="{{ p_max }}" step="1" placeholder="{{ p_max }}" name="{{ filter.max_value.param_name }}" value="{{ p_hi }}">
                        <span class="facets__price-unit" aria-hidden="true">€</span>
                      </fieldset>
                  {%- endcase -%}
                {%- endfor -%}
              </div>
              <div class="facets__field facets__field--sort">
                <label class="visually-hidden" for="mc-d-{{ mc_id }}-sort">Trier par</label>
                <span class="select"><select class="input facets__select" id="mc-d-{{ mc_id }}-sort" name="sort_by">
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value | escape }}"{% if option.value == mc_sort %} selected{% endif %}>{{ option.name | escape }}</option>
                  {%- endfor -%}
                </select></span>
              </div>
              <noscript><button class="btn btn--ghost btn--sm" type="submit">Appliquer</button></noscript>
            </form>

            {%- comment -%} ---------- Téléphone : bouton qui ouvre la feuille {%- endcomment -%}
            <div class="facets__mobile">
              <button class="btn btn--ghost btn--sm facets__open" type="button" aria-haspopup="dialog" aria-controls="mc-sheet-{{ mc_id }}" aria-expanded="false" data-facets-open>
                <span class="btn__label">Filtrer et trier<span data-facets-badge>{% if mc_active > 0 %} ({{ mc_active }}){% endif %}</span></span>
              </button>
              <p class="facets__count" data-facets-count>{{ mc_count }} {{ mc_word }}</p>
            </div>

            {%- comment -%} ---------- Filtres actifs, supprimables {%- endcomment -%}
            <div class="facets__active" data-facets-active>
              {%- if mc_active > 0 -%}
                <ul class="facets__chips" role="list">
                  {%- for filter in collection.filters -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                        <li><a class="chip facets__remove" href="{{ filter.url_to_remove }}" data-facets-link>
                          {%- liquid
                            assign pc_lo = filter.min_value.value | default: 0 | money_without_trailing_zeros | replace: ' €', ' €'
                            assign pc_hi = filter.max_value.value | default: filter.range_max | money_without_trailing_zeros | replace: ' €', ' €'
                          -%}
                          {{- filter.label | escape }} : {{ pc_lo }} – {{ pc_hi -}}
                          {%- render 'icon', name: 'close', size: 16 -%}<span class="visually-hidden"> (retirer ce filtre)</span></a></li>
                      {%- endif -%}
                    {%- else -%}
                      {%- for v in filter.active_values -%}
                        <li><a class="chip facets__remove" href="{{ v.url_to_remove }}" data-facets-link>{{ filter.label | escape }} : {{ v.label | escape }}{%- render 'icon', name: 'close', size: 16 -%}<span class="visually-hidden"> (retirer ce filtre)</span></a></li>
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <li><a class="facets__clear" href="{{ mc_clear }}" data-facets-link>Tout effacer</a></li>
                </ul>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} ---------- Feuille « Filtrer et trier » (téléphone ; centrée à partir de 900 px) {%- endcomment -%}
          <dialog class="sheet sheet--bottom facets-sheet" id="mc-sheet-{{ mc_id }}" aria-labelledby="mc-sheet-title-{{ mc_id }}">
            <div class="sheet__handle" aria-hidden="true"></div>
            <header class="sheet__head">
              <h2 class="sheet__title" id="mc-sheet-title-{{ mc_id }}">Filtrer et trier</h2>
              <button class="btn btn--icon btn--ghost sheet__close" type="button" aria-label="Fermer" data-sheet-close>{%- render 'icon', name: 'close', size: 20 -%}</button>
            </header>
            <form class="sheet__body facets-sheet__body" action="{{ collection.url }}" method="get" data-facets-form data-facets-sheet id="mc-sheet-form-{{ mc_id }}">
              {%- for filter in collection.filters -%}
                {%- case filter.type -%}
                  {%- when 'list' or 'boolean' -%}
                    <fieldset class="chips facets-sheet__group">
                      <legend>{{ filter.label | escape }}</legend>
                      {%- for v in filter.values -%}
                        <label class="chip" for="mc-s-{{ mc_id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                          <input type="checkbox" id="mc-s-{{ mc_id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" name="{{ v.param_name }}" value="{{ v.value | escape }}"{% if v.active %} checked{% endif %}{% if v.count == 0 and v.active == false %} disabled{% endif %}>
                          {{- v.label | escape -}}<span class="facets-sheet__count">{{ v.count }}</span>
                        </label>
                      {%- endfor -%}
                    </fieldset>
                  {%- when 'price_range' -%}
                    {%- liquid
                      assign p_max = filter.range_max | divided_by: 100 | ceil
                      assign p_lo = ''
                      assign p_hi = ''
                      if filter.min_value.value != blank
                        assign p_lo = filter.min_value.value | divided_by: 100
                      endif
                      if filter.max_value.value != blank
                        assign p_hi = filter.max_value.value | divided_by: 100
                      endif
                    -%}
                    <fieldset class="facets-sheet__group facets-sheet__price">
                      <legend>{{ filter.label | escape }} (€)</legend>
                      <div class="field">
                        <label class="field__label" for="mc-s-{{ mc_id }}-pmin">Minimum</label>
                        <input class="input" id="mc-s-{{ mc_id }}-pmin" type="number" inputmode="numeric" enterkeyhint="next" min="0" max="{{ p_max }}" step="1" placeholder="0" name="{{ filter.min_value.param_name }}" value="{{ p_lo }}">
                      </div>
                      <div class="field">
                        <label class="field__label" for="mc-s-{{ mc_id }}-pmax">Maximum</label>
                        <input class="input" id="mc-s-{{ mc_id }}-pmax" type="number" inputmode="numeric" enterkeyhint="done" min="0" max="{{ p_max }}" step="1" placeholder="{{ p_max }}" name="{{ filter.max_value.param_name }}" value="{{ p_hi }}">
                      </div>
                    </fieldset>
                {%- endcase -%}
              {%- endfor -%}
              <fieldset class="chips facets-sheet__group">
                <legend>Trier par</legend>
                {%- for option in collection.sort_options -%}
                  <label class="chip" for="mc-s-{{ mc_id }}-sort-{{ forloop.index }}">
                    <input type="radio" id="mc-s-{{ mc_id }}-sort-{{ forloop.index }}" name="sort_by" value="{{ option.value | escape }}"{% if option.value == mc_sort %} checked{% endif %}>{{ option.name | escape }}
                  </label>
                {%- endfor -%}
              </fieldset>
            </form>
            <footer class="sheet__foot facets-sheet__foot">
              <a class="facets__clear" href="{{ mc_clear }}" data-facets-link>Tout effacer</a>
              <button class="btn btn--chrome facets-sheet__apply" type="submit" form="mc-sheet-form-{{ mc_id }}" data-facets-apply>Voir {{ mc_count }} {{ mc_word }}</button>
            </footer>
          </dialog>

          {%- comment -%} ---------- Résultats {%- endcomment -%}
          <div class="main-collection__results" data-facets-results data-count="{{ mc_count }}">
            {%- if mc_count == 0 -%}
              <div class="main-collection__none">
                <p class="main-collection__none-title">Aucune montre avec ces filtres.</p>
                <p class="main-collection__none-text">Retirez un filtre, ou composez exactement celle que vous cherchez.</p>
                <div class="main-collection__none-actions">
                  <a class="link-arrow" href="/pages/configurateur" data-cta-origin="empty">Créer ma montre{%- render 'icon', name: 'arrow-right', size: 14 -%}</a>
                </div>
              </div>
            {%- else -%}
              <h2 class="visually-hidden">Montres</h2>
              <div class="card-grid main-collection__grid" data-facets-grid>
                {%- liquid
                  assign mc_n = 0
                  assign mc_tile = false
                  if paginate.current_page == 1 and section.settings.show_create
                    assign mc_tile = true
                  endif
                -%}
                {%- for product in collection.products -%}
                  {%- capture mc_tech -%}{%- render 'is-technical', product: product -%}{%- endcapture -%}
                  {%- if mc_tech == '1' -%}{%- continue -%}{%- endif -%}
                  {%- liquid
                    assign mc_eager = false
                    if mc_n < 2 and paginate.current_page == 1
                      assign mc_eager = true
                    endif
                  -%}
                  {%- render 'product-card', product: product, eager: mc_eager, index: mc_n -%}
                  {%- assign mc_n = mc_n | plus: 1 -%}
                  {%- if mc_n == 2 and mc_tile -%}
                    {%- render 'product-card', create: true, index: mc_n -%}
                    {%- assign mc_tile = false -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if mc_tile -%}{%- render 'product-card', create: true, index: mc_n -%}{%- endif -%}
              </div>

              {%- if paginate.pages > 1 -%}
                <div class="main-collection__more" data-facets-more>
                  {%- if paginate.next.is_link -%}
                    <a class="btn btn--ghost main-collection__more-btn" href="{{ paginate.next.url }}" data-load-more>Voir plus de montres</a>
                  {%- endif -%}
                  <nav class="main-collection__pages" aria-label="Pagination">
                    <ul role="list">
                      {%- if paginate.previous.is_link -%}
                        <li><a class="main-collection__page" href="{{ paginate.previous.url }}">{%- render 'icon', name: 'arrow-left', size: 14 -%}Précédent</a></li>
                      {%- endif -%}
                      {%- for part in paginate.parts -%}
                        {%- if part.is_link -%}
                          <li><a class="main-collection__page" href="{{ part.url }}">{{ part.title }}</a></li>
                        {%- elsif part.title == paginate.current_page -%}
                          <li><span class="main-collection__page" aria-current="page">{{ part.title }}</span></li>
                        {%- else -%}
                          <li><span class="main-collection__page main-collection__page--gap">{{ part.title }}</span></li>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if paginate.next.is_link -%}
                        <li><a class="main-collection__page" href="{{ paginate.next.url }}">Suivant{%- render 'icon', name: 'arrow-right', size: 14 -%}</a></li>
                      {%- endif -%}
                    </ul>
                  </nav>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endpaginate -%}
      {%- endif -%}
    </mig-facets>
  </div>
</section>

{%- comment -%} Fil d'Ariane en données structurées (§15.2) {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": {{ shop.url | append: routes.root_url | json }} },
      { "@type": "ListItem", "position": 2, "name": "Collections", "item": {{ shop.url | append: routes.collections_url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    ]
  }
</script>
<script src="{{ 'section-main-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Montres par page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_create", "label": "Afficher la tuile « Créer la vôtre » (3e position)", "default": true }
  ]
}
{% endschema %}
