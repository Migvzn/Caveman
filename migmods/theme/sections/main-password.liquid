{{ 'section-main-password.css' | asset_url | stylesheet_tag }}
{{ 'component-sig-card.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Pré-ouverture (DESIGN-SYSTEM.md §9.15, §11.13) : logo, H1, chapô, capsule « Me prévenir » (formulaire client, étiquette prelancement),
  mention RGPD, trois créations sans lien vers le configurateur (boutique fermée), Instagram, puis « Accès gérant » (mot de passe).
{%- endcomment -%}
{%- liquid
  assign pw = section.settings
  assign pw_id = 'password-title-' | append: section.id
  assign pw_insta = settings.social_instagram | strip
  if pw_insta != blank
    unless pw_insta contains 'http'
      assign pw_handle = pw_insta | remove: '@'
      assign pw_insta = 'https://www.instagram.com/' | append: pw_handle
    endunless
  endif
-%}
<section class="main-password" aria-labelledby="{{ pw_id }}">
  <div class="page-width page-width--text main-password__inner">
    <div class="main-password__logo">{% render 'logo', context: 'plain', class: 'main-password__logo-img' %}</div>
    <h1 class="main-password__title" id="{{ pw_id }}" data-light>{% render 'typo-fr', text: pw.heading %}</h1>
    {%- if pw.lead != blank -%}<p class="main-password__lead">{% render 'typo-fr', text: pw.lead %}</p>{%- endif -%}

    {%- form 'customer', id: 'prelancement', class: 'main-password__form' -%}
      <input type="hidden" name="contact[tags]" value="prelancement">
      {%- if form.posted_successfully? -%}
        <p class="main-password__success" role="status">{%- render 'icon', name: 'check', size: 20 -%}<span>{% render 'typo-fr', text: pw.success %}</span></p>
      {%- else -%}
        <div class="capsule main-password__capsule">
          <label class="visually-hidden" for="pw-email">Votre e-mail</label>
          <input class="capsule__input" id="pw-email" type="email" name="contact[email]" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" enterkeyhint="send" required placeholder="Votre e-mail" value="{{ form.email }}"{% if form.errors %} aria-invalid="true" aria-describedby="pw-email-error"{% endif %}>
          <button class="btn btn--chrome btn--sm capsule__btn" type="submit" data-light><span class="btn__label">{% render 'typo-fr', text: pw.button %}</span></button>
        </div>
        {%- if form.errors -%}
          <p class="field__error main-password__error" id="pw-email-error" role="alert">{%- render 'icon', name: 'alert', size: 16 -%}<span>Adresse e-mail incomplète : il manque le @ ou le domaine.</span></p>
        {%- endif -%}
        <p class="main-password__rgpd">{% render 'typo-fr', text: pw.privacy %}</p>
      {%- endif -%}
    {%- endform -%}
  </div>

  {%- if pw.show_signatures -%}
    <div class="page-width main-password__sigs">
      <h2 class="eyebrow main-password__sigs-title">{% render 'typo-fr', text: pw.signatures_title %}</h2>
      <div class="rail main-password__rail" data-rail>
        <ul class="rail__track main-password__track" tabindex="0" aria-label="Créations signature" role="list">
          {%- render 'signature-list', layout: 'card', limit: 3, link: false -%}
        </ul>
        <div class="rail__nav main-password__rail-nav"><span class="rail__count" data-rail-count aria-hidden="true">01 / 03</span><span class="rail__dots" data-rail-dots aria-hidden="true"></span></div>
      </div>
    </div>
  {%- endif -%}

  <div class="page-width page-width--text main-password__foot">
    {%- if pw_insta != blank -%}
      <a class="link-arrow" href="{{ pw_insta }}" target="_blank" rel="noopener">{%- render 'icon', name: 'instagram', size: 14 -%}Suivre l’atelier sur Instagram<span class="visually-hidden"> (nouvel onglet)</span></a>
    {%- endif -%}

    {%- form 'storefront_password', class: 'main-password__admin-form' -%}
      <details class="password-admin"{% if form.errors %} open{% endif %}>
        <summary class="password-admin__summary">Accès gérant{%- render 'icon', name: 'chevron-down', size: 14, class: 'password-admin__chevron' -%}</summary>
        <div class="password-admin__body">
          {%- if form.errors -%}
            <p class="field__error" id="pw-admin-error" role="alert">{%- render 'icon', name: 'alert', size: 16 -%}<span>Mot de passe incorrect.</span></p>
          {%- endif -%}
          <div class="capsule">
            <label class="visually-hidden" for="pw-admin">Mot de passe de la boutique</label>
            <input class="capsule__input" id="pw-admin" type="password" name="password" autocomplete="current-password" enterkeyhint="go" placeholder="Mot de passe"{% if form.errors %} aria-invalid="true" aria-describedby="pw-admin-error"{% endif %}>
            <button class="btn btn--ghost btn--sm capsule__btn" type="submit"><span class="btn__label">Entrer</span></button>
          </div>
        </div>
      </details>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "info": "Un seul mot ou groupe en italique (chromé).", "default": "Ouverture <em>prochaine</em>" },
    { "type": "text", "id": "lead", "label": "Chapô", "default": "Les premières MigMods sont à l’établi. Laissez votre e-mail : vous serez prévenu(e) le jour de l’ouverture." },
    { "type": "text", "id": "button", "label": "Bouton", "default": "Me prévenir" },
    { "type": "text", "id": "privacy", "label": "Mention de confidentialité", "default": "Désinscription en un clic. Votre adresse n’est jamais partagée." },
    { "type": "text", "id": "success", "label": "Message après inscription", "default": "C’est noté : vous serez prévenu(e) le jour de l’ouverture." },
    { "type": "checkbox", "id": "show_signatures", "label": "Montrer trois créations signature", "default": true },
    { "type": "text", "id": "signatures_title", "label": "Titre des créations", "default": "À l’établi" }
  ]
}
{% endschema %}
