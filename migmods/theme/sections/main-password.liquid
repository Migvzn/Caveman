<section class="password">
  <div class="page-width page-width--narrow">
    <span class="wordmark">{{ shop.name | upcase }}</span>
    <h1 class="page-title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prelancement">
      <label class="visually-hidden" for="pw-email">E-mail</label>
      <div class="field-inline">
        <input id="pw-email" class="input" type="email" name="contact[email]" required placeholder="Votre e-mail">
        <button class="btn btn--primary" type="submit">Me prévenir</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="form-success" role="status">Merci, vous serez prévenu à l'ouverture.</p>{%- endif -%}
    {%- endform -%}
    <details class="password__admin">
      <summary>Entrer avec le mot de passe</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-error" role="alert">Mot de passe incorrect.</p>{%- endif -%}
        <label class="visually-hidden" for="pw">Mot de passe</label>
        <div class="field-inline">
          <input id="pw" class="input" type="password" name="password" autocomplete="current-password">
          <button class="btn btn--line" type="submit">Entrer</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Page mot de passe", "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Ouverture prochaine" }] }
{% endschema %}
