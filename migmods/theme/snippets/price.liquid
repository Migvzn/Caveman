{%- comment -%} Prix TTC. Paramètres : product (ou variant). {%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}" data-price>
  {%- if product.price_varies and variant == blank -%}
    <span class="price__now">À partir de {{ product.price_min | money }}</span>
  {%- else -%}
    <span class="price__now">{{ target.price | money }}</span>
    {%- if on_sale -%}<s class="price__was"><span class="visually-hidden">Prix habituel</span>{{ compare | money }}</s>{%- endif -%}
  {%- endif -%}
  <span class="price__tax">TTC</span>
</div>
