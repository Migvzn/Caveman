{%- comment -%}
  Icônes MigMods (DESIGN-SYSTEM.md §6.25). Grille de 24, trait de 1,25, extrémités arrondies, couleur = currentColor.
  Usage : {% render 'icon', name: 'arrow-right', class: 'btn__icon', size: 20 %} — size par défaut : 24 (attributs width/height).
  Compatibilité phase 0 : l'ancien paramètre « icon » (icon: 'search'…) rend l'ancien dessin, jusqu'à la réécriture des sections.
{%- endcomment -%}
{%- if name != blank -%}
  {%- liquid
    assign s = size | default: 24
    case name
      when 'arrow-right'
        assign d = '<path d="M4 12h15.5M13.5 6l6 6-6 6"/>'
      when 'arrow-left'
        assign d = '<path d="M20 12H4.5M10.5 6l-6 6 6 6"/>'
      when 'arrow-up-right'
        assign d = '<path d="M6.5 17.5 17 7M8 6.5h9.5V16"/>'
      when 'chevron-down'
        assign d = '<path d="m6 9 6 6 6-6"/>'
      when 'chevron-left'
        assign d = '<path d="m15 6-6 6 6 6"/>'
      when 'chevron-right'
        assign d = '<path d="m9 6 6 6-6 6"/>'
      when 'plus'
        assign d = '<path d="M12 5v14M5 12h14"/>'
      when 'minus'
        assign d = '<path d="M5 12h14"/>'
      when 'close'
        assign d = '<path d="m6 6 12 12M18 6 6 18"/>'
      when 'check'
        assign d = '<path d="m5 12.5 4.5 4.5L19 7"/>'
      when 'alert'
        assign d = '<circle cx="12" cy="12" r="8.75"/><path d="M12 7.5v5.25M12 16.25v.25"/>'
      when 'search'
        assign d = '<circle cx="10.75" cy="10.75" r="6.25"/><path d="m15.5 15.5 4.75 4.75"/>'
      when 'bag'
        assign d = '<path d="M5.5 8.5h13l-1 12h-11z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>'
      when 'user'
        assign d = '<circle cx="12" cy="8" r="3.75"/><path d="M4.75 20.25c1.25-3.5 4-5.5 7.25-5.5s6 2 7.25 5.5"/>'
      when 'menu'
        assign d = '<path d="M4 9h16M4 15h16"/>'
      when 'sound-on'
        assign d = '<path d="M4.5 9.5h3L12 6v12l-4.5-3.5h-3z"/><path d="M15.5 9.5a3.5 3.5 0 0 1 0 5M18 7a7 7 0 0 1 0 10"/>'
      when 'sound-off'
        assign d = '<path d="M4.5 9.5h3L12 6v12l-4.5-3.5h-3z"/><path d="m15.75 10 4 4M19.75 10l-4 4"/>'
      when 'play'
        assign d = '<path d="M8 5.75v12.5L18.25 12z"/>'
      when 'pause'
        assign d = '<path d="M9 6v12M15 6v12"/>'
      when 'expand'
        assign d = '<path d="M4.5 9V4.5H9M15 4.5h4.5V9M19.5 15v4.5H15M9 19.5H4.5V15"/>'
      when 'copy'
        assign d = '<rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M15.5 8.5V6.25a1.75 1.75 0 0 0-1.75-1.75h-7.5A1.75 1.75 0 0 0 4.5 6.25v7.5c0 .97.78 1.75 1.75 1.75H8.5"/>'
      when 'share'
        assign d = '<path d="M12 15V4M8 8l4-4 4 4"/><path d="M8 11H5.5v8.5h13V11H16"/>'
      when 'mail'
        assign d = '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>'
      when 'pin'
        assign d = '<path d="M12 20.75s6.75-6 6.75-11a6.75 6.75 0 0 0-13.5 0c0 5 6.75 11 6.75 11z"/><circle cx="12" cy="9.75" r="2.5"/>'
      when 'clock'
        assign d = '<circle cx="12" cy="12" r="8.75"/><path d="M12 7.25V12l3.25 2"/>'
      when 'hand'
        assign d = '<circle cx="14" cy="6.75" r="2.75"/><path d="M3.5 14.25h3l3.25 2.5h4.25a1.5 1.5 0 0 0 0-3h-2.5"/><path d="M6.5 19.75h8.75l5.25-4.25a1.6 1.6 0 0 0-2.1-2.4l-2.9 2.4"/><path d="M6.5 13.5v6.75"/>'
      when 'car'
        assign d = '<path d="M4.25 16v-3.5L6.5 7.25h11l2.25 5.25V16"/><path d="M3.5 16h17M4.75 12.5h14.5"/><circle cx="7.75" cy="17.25" r="1.75"/><circle cx="16.25" cy="17.25" r="1.75"/>'
      when 'parcel'
        assign d = '<path d="M12 3.5 20 7.5v9L12 20.5 4 16.5v-9z"/><path d="M4 7.5l8 4 8-4M12 11.5v9M8 5.5l8 4"/>'
      when 'drop'
        assign d = '<path d="M12 3.75c3.5 4.5 6 8 6 10.75a6 6 0 0 1-12 0C6 11.75 8.5 8.25 12 3.75z"/><path d="M9 14.75a3 3 0 0 0 3 3"/>'
      when 'gauge'
        assign d = '<path d="M4.5 17a7.5 7.5 0 1 1 15 0"/><path d="m12 17 3.75-6.25M12 9.5v-1M7.25 11.5l-.75-.75M16.75 11.5l.75-.75"/>'
      when 'shield'
        assign d = '<path d="M12 3.5 19 6v5.5c0 4.5-3 7.75-7 9-4-1.25-7-4.5-7-9V6z"/><path d="m8.75 12 2.25 2.25 4.25-4.5"/>'
      when 'return'
        assign d = '<path d="M9 6.25 5 10.25l4 4"/><path d="M5 10.25h9.5a4.5 4.5 0 0 1 0 9H10"/>'
      when 'instagram'
        assign d = '<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.75"/><path d="M16.75 7.25v.01"/>'
      when 'tiktok'
        assign d = '<path d="M13.5 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M13.5 4c.4 2.6 2.25 4.3 5 4.5"/>'
      else
        assign d = ''
    endcase
  -%}
  {%- if d != blank -%}
    <svg class="icon{% if class != blank %} {{ class }}{% endif %}" data-icon="{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ d }}</svg>
  {%- endif -%}
{%- else -%}
  {%- case icon -%}
    {%- when 'menu' -%}
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
    {%- when 'search' -%}
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="1.4"/></svg>
    {%- when 'account' -%}
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
    {%- when 'bag' -%}
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 8h14l-1 13H6L5 8z" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M9 8V6a3 3 0 016 0v2" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
    {%- when 'crystal' -%}
      <svg class="icon icon--lg" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M14 18c3-5 9-7 14-5" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M17 23c2-3 5-4 8-3.5" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
    {%- when 'movement' -%}
      <svg class="icon icon--lg" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="1.2" fill="none"/><circle cx="24" cy="24" r="6" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M24 7v6M24 35v6M7 24h6M35 24h6M12 12l4 4M32 32l4 4M36 12l-4 4M16 32l-4 4" stroke="currentColor" stroke-width="1.2"/></svg>
    {%- when 'water' -%}
      <svg class="icon icon--lg" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M24 7c6 8 11 14 11 21a11 11 0 01-22 0c0-7 5-13 11-21z" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M18 29a6 6 0 006 6" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
    {%- when 'hand' -%}
      <svg class="icon icon--lg" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="17" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M24 24V12M24 24l8 5" stroke="currentColor" stroke-width="1.4"/><circle cx="24" cy="24" r="1.6" fill="currentColor"/></svg>
    {%- when 'pin' -%}
      <svg class="icon icon--lg" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M24 43s13-12.5 13-23a13 13 0 00-26 0c0 10.5 13 23 13 23z" stroke="currentColor" stroke-width="1.2" fill="none"/><circle cx="24" cy="20" r="4.5" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
    {%- when 'shield' -%}
      <svg class="icon icon--lg" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M24 6l15 5v11c0 10-6.5 17-15 20-8.5-3-15-10-15-20V11l15-5z" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M17 24l5 5 9-10" stroke="currentColor" stroke-width="1.2" fill="none"/></svg>
  {%- endcase -%}
{%- endif -%}
