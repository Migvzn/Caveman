<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'fr' }}" class="no-js{% unless settings.motion_bg %} bg-still{% endunless %}">
  <head>
    {%- comment -%}
      Pré-ouverture (DESIGN-SYSTEM.md §9.15) : même tête que layout/theme.liquid (tokens, polices, theme.css, theme.js, vagues),
      sans en-tête ni pied de page. Lot pages.
    {%- endcomment -%}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg | default: '#050505' }}">

    <title>MigMods — Montres Seiko mod assemblées à la main à Évreux · Ouverture prochaine</title>
    <meta name="description" content="{{ page_description | default: 'Montres Seiko mod assemblées à la main à Évreux. Ouverture prochaine : laissez votre e-mail, vous serez prévenu(e) le jour de l’ouverture.' | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ 'cormorant-garamond-300.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'inter.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <link rel="preload" as="image" href="{{ 'migmods-hero-poster.jpg' | asset_url }}" media="(max-width: 899px)" fetchpriority="high">
    <link rel="preload" as="image" href="{{ 'migmods-hero-poster-land.jpg' | asset_url }}" media="(min-width: 900px)" fetchpriority="high">

    {% render 'css-variables' %}

    <script>
      (function (h) {
        h.className = h.className.replace('no-js', 'js');
        try { if (localStorage.getItem('mig-still') === '1') h.classList.add('is-still'); } catch (e) {}
      })(document.documentElement);
      window.MigConfig = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartUpdate: {{ routes.cart_update_url | append: '.js' | json }},
          search: {{ routes.search_url | json }},
          predictive: {{ routes.predictive_search_url | json }}
        },
        freeLocalThreshold: {{ settings.free_local_threshold | default: 300 | times: 100 }}
      };
    </script>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'migmods-waves.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <div class="site-bg" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position: absolute">
      <defs>
        <linearGradient id="mig-chrome-stroke" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="24" y2="24">
          <stop offset="0" stop-color="#fff"/><stop offset=".3" stop-color="#7d838b"/><stop offset=".5" stop-color="#f2f3f5"/><stop offset=".7" stop-color="#6c7179"/><stop offset="1" stop-color="#fff"/>
        </linearGradient>
        <linearGradient id="mig-chrome-ring" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff"/><stop offset=".3" stop-color="#7d838b"/><stop offset=".5" stop-color="#f2f3f5"/><stop offset=".7" stop-color="#6c7179"/><stop offset="1" stop-color="#fff"/>
        </linearGradient>
        <linearGradient id="mig-chrome-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff"/><stop offset=".34" stop-color="#e8eaed"/><stop offset=".56" stop-color="#9ea3ab"/><stop offset=".76" stop-color="#f1f2f4"/><stop offset="1" stop-color="#c3c7cd"/>
        </linearGradient>
        <path id="mig-hallmark-path" d="M32 32m-24.5 0a24.5 24.5 0 1 1 49 0a24.5 24.5 0 1 1-49 0"/>
      </defs>
    </svg>

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <div id="mig-live" class="visually-hidden" aria-live="polite"></div>
  </body>
</html>
