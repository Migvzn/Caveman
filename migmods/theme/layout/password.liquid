<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    <style>
      @font-face { font-family: "Cormorant Garamond"; src: url("{{ 'cormorant-garamond.woff2' | asset_url }}") format("woff2"); font-weight: 300 700; font-display: swap; }
      @font-face { font-family: "Inter"; src: url("{{ 'inter.woff2' | asset_url }}") format("woff2"); font-weight: 100 900; font-display: swap; }
      :root { --c-bg: {{ settings.color_bg }}; --c-surface: {{ settings.color_surface }}; --c-ink: {{ settings.color_ink }}; --c-stone: {{ settings.color_stone }}; --c-line: {{ settings.color_line }}; --c-brass: {{ settings.color_brass }}; --page-width: {{ settings.page_width }}px; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
