[
  {
    "name": "theme_info",
    "theme_name": "MigMods",
    "theme_version": "1.0.0",
    "theme_author": "MigMods",
    "theme_documentation_url": "https://help.shopify.com/fr/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/fr"
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Fond (noir)",
        "default": "#050505"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (cartes, champs)",
        "default": "#0E0E0F"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Texte",
        "default": "#F3F4F6"
      },
      {
        "type": "color",
        "id": "color_stone",
        "label": "Texte secondaire",
        "default": "#9CA0A7"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Filets",
        "default": "#222326",
        "info": "Plus utilisé par le thème (conservé pour compatibilité)."
      },
      {
        "type": "color",
        "id": "color_brass",
        "label": "Accent chromé",
        "default": "#CFD3D9",
        "info": "Ancien accent : plus utilisé après la refonte (conservé pour compatibilité)."
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Largeur maximale",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1360
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (32×32 px)"
      }
    ]
  },
  {
    "name": "Logo et filigrane",
    "settings": [
      {
        "type": "image_picker",
        "id": "brand_logo",
        "label": "Logo (PNG transparent)",
        "info": "Vide = logo chromé MigMods fourni avec le thème."
      },
      {
        "type": "checkbox",
        "id": "watermark",
        "label": "Afficher le logo sur les photos de montres",
        "default": true
      },
      {
        "type": "range",
        "id": "watermark_size",
        "label": "Taille du logo sur les photos",
        "min": 12,
        "max": 40,
        "step": 2,
        "unit": "%",
        "default": 24
      },
      {
        "type": "range",
        "id": "watermark_opacity",
        "label": "Opacité du logo",
        "min": 30,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 85
      },
      {
        "type": "select",
        "id": "watermark_position",
        "label": "Position",
        "default": "bottom-right",
        "options": [
          {
            "value": "bottom-right",
            "label": "En bas à droite"
          },
          {
            "value": "bottom-left",
            "label": "En bas à gauche"
          },
          {
            "value": "bottom-center",
            "label": "En bas au centre"
          },
          {
            "value": "top-right",
            "label": "En haut à droite"
          }
        ]
      },
      {
        "type": "text",
        "id": "watermark_tags",
        "label": "Seulement sur les produits de type",
        "default": "Montre",
        "info": "Vide = toutes les photos produits."
      }
    ]
  },
  {
    "name": "Réassurance",
    "settings": [
      {
        "type": "text",
        "id": "delivery_line",
        "label": "Ligne livraison (fiche produit, configurateur)",
        "default": "Livraison en main propre possible dans l'Eure (27) et à Rouen"
      },
      {
        "type": "text",
        "id": "lead_ready",
        "label": "Délai montres prêtes",
        "default": "Expédiée sous 48 h"
      },
      {
        "type": "text",
        "id": "lead_custom",
        "label": "Délai montres configurées",
        "default": "Assemblée sous 2 à 3 semaines"
      },
      {
        "type": "text",
        "id": "warranty",
        "label": "Garantie",
        "default": "Garantie [À COMPLÉTER] mois sur l'assemblage et le mouvement"
      },
      {
        "type": "text",
        "id": "returns",
        "label": "Retours",
        "default": "Retours sous 14 jours (montres prêtes à porter)"
      }
    ]
  },
  {
    "name": "Atelier et contact",
    "settings": [
      {
        "type": "text",
        "id": "atelier_city",
        "label": "Ville de l'atelier",
        "default": "Évreux, Normandie"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "E-mail de contact",
        "info": "Affiché dans le pied de page et dans les données structurées. Vide = non affiché."
      }
    ]
  },
  {
    "name": "Livraison",
    "settings": [
      {
        "type": "range",
        "id": "free_local_threshold",
        "label": "Remise en main propre offerte à partir de",
        "min": 100,
        "max": 600,
        "step": 10,
        "unit": "€",
        "default": 300
      },
      {
        "type": "textarea",
        "id": "hand_delivery_codes",
        "label": "Codes postaux de la remise en main propre",
        "info": "Un code par ligne ; « 27* » = tous les codes qui commencent par 27. Lu par la section Livraison locale quand sa propre liste est vide. Liste 76 à vérifier (voir le guide).",
        "default": "27*\n76000\n76100\n76113\n76120\n76130\n76140\n76150\n76160\n76230\n76240\n76250\n76300\n76320\n76350\n76380\n76410\n76420\n76480\n76500\n76520\n76530\n76580\n76770\n76800\n76840\n76960"
      }
    ]
  },
  {
    "name": "Mouvement",
    "settings": [
      {
        "type": "checkbox",
        "id": "motion_bg",
        "label": "Fond animé",
        "info": "Décoché : fond noir figé. Le fond se fige aussi d'office si le visiteur a demandé moins d'animations.",
        "default": true
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram (lien complet)",
        "placeholder": "https://www.instagram.com/migmods"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok (lien complet)",
        "placeholder": "https://www.tiktok.com/@migmods"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook (lien complet)"
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "product",
        "id": "custom_watch_product",
        "label": "Produit « Montre sur-mesure »",
        "info": "Sert à regrouper les composants sous la montre dans le panier."
      }
    ]
  }
]