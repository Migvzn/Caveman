<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Carte cadeau {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="gift-card">
    <main class="page-width page-width--narrow section">
      <span class="wordmark">{{ shop.name | upcase }}</span>
      <h1 class="page-title">Votre carte cadeau</h1>
      <p class="gift-card__amount">{{ gift_card.initial_value | money }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}<p>Solde restant : {{ gift_card.balance | money }}</p>{%- endif -%}
      {%- if gift_card.expired or gift_card.enabled == false -%}<p class="form-error">Cette carte n'est plus valable.</p>{%- endif -%}
      <p>Code : <strong class="gift-card__code">{{ gift_card.code | format_code }}</strong></p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <div class="btn-row">
        <a class="btn btn--primary" href="{{ shop.url }}">Utiliser la carte</a>
        {%- if gift_card.pass_url -%}<a class="btn btn--line" href="{{ gift_card.pass_url }}">Ajouter à Apple Wallet</a>{%- endif -%}
      </div>
    </main>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
